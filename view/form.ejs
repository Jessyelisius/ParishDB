<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Helvetica">
    <title>SJMCC Registration Form</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="header-content">
                <img src="/img/background.png" alt="Parish Logo" class="parish-logo">
                <div>
                    <h1>ST JOSEPH MUKASA CATHOLIC PARISH</h1>
                    <p>Gidan Mangoro - Registration Form</p>
                </div>
                <img src="/img/bg1.jpg" alt="Jesuits Logo" class="jesuits-logo">
            </div>
        </div>

        <div class="registration-type">
            <button class="type-btn active" onclick="showForm('single')">Single Member</button>
            <button class="type-btn" onclick="showForm('married')">Married Couple</button>
            <button class="type-btn" onclick="showForm('youth')">Youth (18+)</button>
        </div>

        <div class="form-container">
            <div id="alertBox" class="alert"></div>

            <!-- SINGLE MEMBER FORM -->
            <div id="singleForm" class="form-section active">
                <h2 class="section-title">Single Member Registration</h2>
                
                <form id="singleMemberForm">
                    <h3 class="section-subtitle">Parishioner Status</h3>
                    <div class="status-group">
                        <label class="radiobutton">
                            New Parishioner
                            <input type="radio" name="parishionerStatus" value="New Parishioner" checked>
                            <span class="indicator"></span>
                        </label>
                        <label class="radiobutton">
                            Existing Parishioner
                            <input type="radio" name="parishionerStatus" value="Parishioner">
                            <span class="indicator"></span>
                        </label>
                    </div>

                    <h3 class="section-subtitle">Personal Information</h3>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">person</span></div>
                        <input type="text" name="fullName" placeholder="Full Name" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">mail_outline</span></div>
                        <input type="email" name="email" placeholder="Email" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">phone</span></div>
                        <input type="tel" name="phoneNumber" placeholder="Phone Number" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">location_on</span></div>
                        <input type="text" name="address" placeholder="Address" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">groups</span></div>
                        <input type="text" name="group" placeholder="Society/Group">
                    </div>
                    <div class="box">
                        <div class="icon"><span>State</span></div>
                        <input type="text" name="stateOfOrigin" placeholder="State of Origin">
                    </div>
                    <div class="box">
                        <div class="icon"><span>Zone</span></div>
                        <input type="number" name="zone" placeholder="Zone Number">
                    </div>
                    <div class="box">
                        <div class="icon"><span>Work</span></div>
                        <input type="text" name="occupation" placeholder="Occupation">
                    </div>
                    <div class="box">
                        <div class="icon"><span>DOB</span></div>
                        <input type="date" name="dateOfBirth" required>
                    </div>

                    <h3 class="section-subtitle">Catholic Sacraments Received</h3>
                    <div class="sacrament-group">
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="baptism">
                            <span>Baptism</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="firstHolyCommunion">
                            <span>1st Holy Communion</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="confirmation">
                            <span>Confirmation</span>
                        </label>
                    </div>

                    <h3 class="section-subtitle">Ministry Involvement</h3>
                    <div class="box">
                        <div class="icon"><span>⛪</span></div>
                        <select name="ministry">
                            <option value="">Select Ministry (Optional)</option>
                            <option value="Eucharist Minister">Eucharist Minister</option>
                            <option value="PSR Teacher">PSR Teacher</option>
                            <option value="Lector">Lector</option>
                            <option value="Mass Server">Mass Server</option>
                            <option value="Money Counter">Money Counter</option>
                            <option value="Choir">Choir</option>
                            <option value="Usher">Usher</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">psychology_alt</span></div>
                        <textarea name="otherSkills" placeholder="Other skills or talents you could use to serve the Parish Community"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Register</button>
                </form>
            </div>

            <!-- MARRIED COUPLE FORM -->
            <div id="marriedForm" class="form-section">
                <h2 class="section-title">Married Couple Registration</h2>
                
                <div class="info-box">
                    <strong>Note:</strong> This form registers both you and your spouse together as a family unit.
                </div>

                <form id="marriedCoupleForm">
                    <h3 class="section-subtitle">Parishioner Status</h3>
                    <div class="status-group">
                        <label class="radiobutton">
                            New Parishioners
                            <input type="radio" name="parishionerStatus" value="New Parishioner" checked>
                            <span class="indicator"></span>
                        </label>
                        <label class="radiobutton">
                            Existing Parishioners
                            <input type="radio" name="parishionerStatus" value="Parishioner">
                            <span class="indicator"></span>
                        </label>
                    </div>

                    <h3 class="section-subtitle">Your Information</h3>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">person</span></div>
                        <input type="text" name="fullName" placeholder="Your Full Name" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">mail_outline</span></div>
                        <input type="email" name="email" placeholder="Your Email" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">phone</span></div>
                        <input type="tel" name="phoneNumber" placeholder="Your Phone Number" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">location_on</span></div>
                        <input type="text" name="address" placeholder="Family Address" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">groups</span></div>
                        <input type="text" name="group" placeholder="Your Society/Group">
                    </div>
                    <div class="box">
                        <div class="icon"><span>State</span></div>
                        <input type="text" name="stateOfOrigin" placeholder="Your State of Origin">
                    </div>
                    <div class="box">
                        <div class="icon"><span>Zone</span></div>
                        <input type="number" name="zone" placeholder="Zone Number">
                    </div>
                    <div class="box">
                        <div class="icon"><span>Work</span></div>
                        <input type="text" name="occupation" placeholder="Your Occupation">
                    </div>
                    <div class="box">
                        <div class="icon"><span>DOB</span></div>
                        <input type="date" name="dateOfBirth" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span>👶</span></div>
                        <input type="number" name="numberOfKids" placeholder="Number of Kids" min="0">
                    </div>

                    <h3 class="section-subtitle">Your Catholic Sacraments</h3>
                    <div class="sacrament-group">
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="baptism">
                            <span>Baptism</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="firstHolyCommunion">
                            <span>1st Holy Communion</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="confirmation">
                            <span>Confirmation</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="holyMatrimony">
                            <span>Holy Matrimony</span>
                        </label>
                    </div>

                    <div class="spouse-section">
                        <h3 class="section-subtitle">Spouse Information</h3>
                        <div class="box">
                            <div class="icon"><span class="material-icons-round">person</span></div>
                            <input type="text" name="spouse.fullName" placeholder="Spouse Full Name" required>
                        </div>
                        <div class="box">
                            <div class="icon"><span class="material-icons-round">mail_outline</span></div>
                            <input type="email" name="spouse.email" placeholder="Spouse Email">
                        </div>
                        <div class="box">
                            <div class="icon"><span class="material-icons-round">phone</span></div>
                            <input type="tel" name="spouse.phoneNumber" placeholder="Spouse Phone Number">
                        </div>
                        <div class="box">
                            <div class="icon"><span class="material-icons-round">groups</span></div>
                            <input type="text" name="spouse.society" placeholder="Spouse Society/Group">
                        </div>
                        <div class="box">
                            <div class="icon"><span>State</span></div>
                            <input type="text" name="spouse.stateOfOrigin" placeholder="Spouse State of Origin">
                        </div>
                        <div class="box">
                            <div class="icon"><span>DOB</span></div>
                            <input type="date" name="spouse.dateOfBirth">
                        </div>
                        <div class="box">
                            <div class="icon"><span>Work</span></div>
                            <input type="text" name="spouse.occupation" placeholder="Spouse Occupation">
                        </div>

                        <h3 class="section-subtitle">Spouse Catholic Sacraments</h3>
                        <div class="sacrament-group">
                            <label class="checkbox-wrapper">
                                <input type="checkbox" name="spouse.baptism">
                                <span>Baptism</span>
                            </label>
                            <label class="checkbox-wrapper">
                                <input type="checkbox" name="spouse.holyCommunion">
                                <span>1st Holy Communion</span>
                            </label>
                            <label class="checkbox-wrapper">
                                <input type="checkbox" name="spouse.confirmation">
                                <span>Confirmation</span>
                            </label>
                            <label class="checkbox-wrapper">
                                <input type="checkbox" name="spouse.matrimony">
                                <span>Holy Matrimony</span>
                            </label>
                        </div>
                    </div>

                    <h3 class="section-subtitle">Ministry Involvement</h3>
                    <div class="box">
                        <div class="icon"><span>⛪</span></div>
                        <select name="ministry">
                            <option value="">Select Ministry (Optional)</option>
                            <option value="Eucharist Minister">Eucharist Minister</option>
                            <option value="PSR Teacher">PSR Teacher</option>
                            <option value="Lector">Lector</option>
                            <option value="Mass Server">Mass Server</option>
                            <option value="Money Counter">Money Counter</option>
                            <option value="Choir">Choir</option>
                            <option value="Usher">Usher</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">psychology_alt</span></div>
                        <textarea name="otherSkills" placeholder="Other skills or talents to serve the Parish Community"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Register Couple</button>
                </form>
            </div>

            <!-- YOUTH FORM -->
            <div id="youthForm" class="form-section">
                <h2 class="section-title">Youth Registration (18+)</h2>
                
                <div class="info-box">
                    <strong>Note:</strong> This form is for youth (18+) registering under their parents' family.
                </div>

                <form id="youthMemberForm">
                    <div class="family-search">
                        <h3 class="section-subtitle">Find Your Family</h3>
                        <div class="box">
                            <div class="icon"><span class="material-icons-round">search</span></div>
                            <input type="text" id="familySearchInput" placeholder="Search by parent's name...">
                        </div>
                        <button type="button" class="btn btn-primary" onclick="searchFamilies()">Search Families</button>
                        
                        <div id="familyList" class="family-list"></div>
                        <input type="hidden" name="familyId" id="selectedFamilyId">
                    </div>

                    <h3 class="section-subtitle">Your Information</h3>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">person</span></div>
                        <input type="text" name="fullName" placeholder="Your Full Name" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">mail_outline</span></div>
                        <input type="email" name="email" placeholder="Your Email" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">phone</span></div>
                        <input type="tel" name="phoneNumber" placeholder="Your Phone Number" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">location_on</span></div>
                        <input type="text" name="address" placeholder="Your Address" required>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">groups</span></div>
                        <input type="text" name="group" placeholder="Society/Group">
                    </div>
                    <div class="box">
                        <div class="icon"><span>State</span></div>
                        <input type="text" name="stateOfOrigin" placeholder="State of Origin">
                    </div>
                    <div class="box">
                        <div class="icon"><span>Work</span></div>
                        <input type="text" name="occupation" placeholder="Occupation">
                    </div>
                    <div class="box">
                        <div class="icon"><span>DOB</span></div>
                        <input type="date" name="dateOfBirth" required>
                    </div>

                    <h3 class="section-subtitle">Marital Status</h3>
                    <div class="status-group">
                        <label class="radiobutton">
                            Single
                            <input type="radio" name="maritalStatus" value="Single" checked>
                            <span class="indicator"></span>
                        </label>
                        <label class="radiobutton">
                            Married
                            <input type="radio" name="maritalStatus" value="Married">
                            <span class="indicator"></span>
                        </label>
                    </div>

                    <h3 class="section-subtitle">Catholic Sacraments Received</h3>
                    <div class="sacrament-group">
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="baptism">
                            <span>Baptism</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="firstHolyCommunion">
                            <span>1st Holy Communion</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="confirmation">
                            <span>Confirmation</span>
                        </label>
                        <label class="checkbox-wrapper">
                            <input type="checkbox" name="holyMatrimony">
                            <span>Holy Matrimony</span>
                        </label>
                    </div>

                    <h3 class="section-subtitle">Ministry Involvement</h3>
                    <div class="box">
                        <div class="icon"><span>⛪</span></div>
                        <select name="ministry">
                            <option value="">Select Ministry (Optional)</option>
                            <option value="Eucharist Minister">Eucharist Minister</option>
                            <option value="PSR Teacher">PSR Teacher</option>
                            <option value="Lector">Lector</option>
                            <option value="Mass Server">Mass Server</option>
                            <option value="Money Counter">Money Counter</option>
                            <option value="Choir">Choir</option>
                            <option value="Usher">Usher</option>
                            <option value="Youth Ministry">Youth Ministry</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="box">
                        <div class="icon"><span class="material-icons-round">psychology_alt</span></div>
                        <textarea name="otherSkills" placeholder="Other skills or talents to serve the Parish Community"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Register</button>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/form.js"></script>
</body>
</html>