<!-- <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Helvetica">
    <title>SJMCC Registration Form</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8f5f 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
            animation: fadeIn 0.6s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .header {
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8f5f 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .header-content img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: white;
            padding: 5px;
        }

        .header h1 {
            font-size: 1.8em;
            margin-bottom: 5px;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.95;
        }

        .registration-type {
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 30px;
            background: #f8f9fa;
            flex-wrap: wrap;
        }

        .type-btn {
            padding: 15px 30px;
            border: 2px solid #1a5f3f;
            background: white;
            color: #1a5f3f;
            border-radius: 30px;
            cursor: pointer;
            font-size: 1em;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .type-btn:hover {
            background: #1a5f3f;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(26, 95, 63, 0.3);
        }

        .type-btn.active {
            background: #1a5f3f;
            color: white;
        }

        .form-container {
            padding: 40px;
        }

        .form-section {
            display: none;
        }

        .form-section.active {
            display: block;
            animation: slideIn 0.4s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .section-title {
            font-size: 1.6em;
            color: #1a5f3f;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid #1a5f3f;
        }

        .section-subtitle {
            font-size: 1.2em;
            color: #2d8f5f;
            margin: 25px 0 15px 0;
            font-weight: 600;
        }

        .status-group {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .radiobutton {
            position: relative;
            padding-left: 40px;
            font-size: 18px;
            cursor: pointer;
            user-select: none;
        }

        .radiobutton input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

        .radiobutton .indicator {
            position: absolute;
            left: 0;
            top: 0;
            width: 24px;
            height: 24px;
            border: 2px solid #1a5f3f;
            border-radius: 50%;
            background: white;
        }

        .radiobutton:hover .indicator {
            background: #f0f0f0;
        }

        .radiobutton input:checked ~ .indicator {
            background: #1a5f3f;
        }

        .radiobutton .indicator::after {
            content: "";
            position: absolute;
            display: none;
            left: 7px;
            top: 3px;
            width: 6px;
            height: 11px;
            border: solid white;
            border-width: 0 3px 3px 0;
            transform: rotate(45deg);
        }

        .radiobutton input:checked ~ .indicator::after {
            display: block;
        }

        .box {
            margin: 15px 0;
            display: flex;
            align-items: center;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .box:focus-within {
            border-color: #1a5f3f;
            box-shadow: 0 0 0 3px rgba(26, 95, 63, 0.1);
        }

        .box .icon {
            background: #1a5f3f;
            color: white;
            padding: 12px 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 50px;
        }

        .box input, .box select, .box textarea {
            flex: 1;
            padding: 12px 15px;
            border: none;
            outline: none;
            font-size: 16px;
            font-family: inherit;
        }

        .box textarea {
            resize: vertical;
            min-height: 100px;
        }

        .sacrament-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .checkbox-wrapper:hover {
            border-color: #1a5f3f;
            background: #f9f9f9;
        }

        .checkbox-wrapper input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .btn {
            padding: 15px 40px;
            border: none;
            border-radius: 30px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 20px;
            width: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, #1a5f3f 0%, #2d8f5f 100%);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(26, 95, 63, 0.3);
        }

        .btn-primary:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
            animation: slideDown 0.3s ease;
        }

        .alert.show {
            display: block;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }

        .info-box {
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 15px;
            margin-bottom: 25px;
            border-radius: 5px;
        }

        .spouse-section {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 10px;
            margin: 20px 0;
        }

        .family-search {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 25px;
        }

        .family-list {
            margin-top: 15px;
            max-height: 300px;
            overflow-y: auto;
        }

        .family-item {
            padding: 15px;
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .family-item:hover {
            border-color: #1a5f3f;
            transform: translateX(5px);
        }

        .family-item.selected {
            border-color: #1a5f3f;
            background: #e8f5e9;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.4em;
            }
            
            .header-content {
                flex-direction: column;
            }
            
            .header-content img {
                width: 60px;
                height: 60px;
            }
            
            .form-container {
                padding: 20px;
            }
            
            .registration-type {
                padding: 20px;
            }
            
            .type-btn {
                width: 100%;
            }
            
            .status-group {
                flex-direction: column;
            }
        }
    </style>
</head>
